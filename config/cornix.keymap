#include <zmk-helpers/helper.h>
#include "includes/cornix54.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#define HM_TAPPING_TERM 250
#define HM_TAPPING_REPEAT 210
#define HM_TAPPING_TERM_FAST    200
#define HM_PRIOR_IDLE           70
#define ORANGE                  0
#define LOWER                   1
#define BASE                    2
#define RAISE                   3
#define GREEN                   4
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH1 LH0 RH0 RH1
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 15

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include <behaviors/rgbled_widget.dtsi> // rgbled-widget custom behavior

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";
        timeout-ms = <35>;

        left_pare {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <9 10>;
        };

        right_pare {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <10 11>;
        };

        left_bracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <21 22>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <22 23>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <36 37>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <0 1>;
        };

        keypad_mo {
            bindings = <&mo 3>;
            key-positions = <43 16>;
        };
    };

    behaviors {
        DKP_TH: DKP_TH {
            compatible = "zmk,behavior-hold-tap";
            label = "DKP_TH";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
        };

        kp_mo: kp_mo {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_MO";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
        };

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <100>;
        };

        mmv_up_down: mmv_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MMV_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;

            tap-ms = <100>;
        };

        mmv_left_right: mmv_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MMV_LEFT_RIGHT";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;

            tap-ms = <100>;
        };

        arrow_HT: arrow_HT {
            compatible = "zmk,behavior-hold-tap";
            label = "ARROW_HT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <260>;
            quick-tap-ms = <250>;
        };

        // modified from urob num_word
        num_word: num_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <
                BACKSPACE DELETE DOT COMMA PLUS MINUS STAR FSLH EQUAL   /* urob default */
                KP_DOT KP_PLUS KP_MULTIPLY KP_DIVIDE KP_MINUS KP_NUMLOCK   /* add num pad */
            >;
            ignore-numbers;
        };

        auto_mouse: auto_mouse {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <PG_UP PG_DN
            UP_ARROW DOWN_ARROW LEFT_ARROW RIGHT_ARROW
            >;
            ignore-modifiers;
        };

        smart_num: smart_num {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_NUM";
            #binding-cells = <2>;
            bindings = <&mo>, <&num_word>;

            tapping-term-ms = <200>;
        };

        smart_mouse: smart_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "SMART_MOUSE";
            #binding-cells = <2>;
            bindings = <&mo>, <&auto_mouse>;

            tapping-term-ms = <200>;
        };

    };

    /* ===== behavior alias define ===== */

    #define A_ALT   &arrow_HT RIGHT_ALT LEFT
    #define A_SFT   &arrow_HT RSHFT     RIGHT
    #define A_CTRL  &arrow_HT RCTRL     DOWN

    #define L5_SP &kp_mo 5 SPACE

    #define SM_L3 &smart_num 3 3
    #define SM_L4 &smart_mouse 4 4

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp Q         &kp W         &kp E  &kp R  &kp T                            &kp Y  &kp U  &kp I  &kp O      &kp P          &kp BACKSPACE
&kp CAPS          &kp A         &kp S         &kp D  &kp F  &kp G                            &kp H  &kp J  &kp K  &kp L      &kp BACKSLASH  &kp ENTER
&kp LSHFT         &kp Z         &kp X         &kp C  &kp V  &kp B      &mkp MB3  &kp C_MUTE  &kp B  &kp N  &kp M  &kp COMMA  &kp PERIOD     &kp SLASH
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &mo 1  &mo 2  &kp SPACE                        L5_SP  SM_L3  SM_L4  A_ALT      A_CTRL         A_SFT
            >;

            sensor-bindings =
                <&scroll_up_down>,
                <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        orange_layer {
            display-name = "Orge";
            bindings = <
&kp GRAVE  &kp NUMBER_1      &kp N2            &kp N3            &kp N4            &kp N5                         &kp N6            &kp N7         &kp N8      &kp N9         &kp N0            &kp DEL
&kp TAB    &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)                     &kp LS(NUMBER_6)  &kp LS(N7)     &kp LS(N8)  &kp SEMICOLON  &kp SINGLE_QUOTE  &none
&none      &none             &none             &none             &none             &none       &kp HOME  &kp END  &none             &none          &none       &kp LS(COMMA)  &kp LS(PERIOD)    &none
&none      &none             &none             &none             &none             &none                          &kp ENTER         &kp BACKSPACE  &none       &none          &none             &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        lower_layer {
            display-name = "Lowr";
            bindings = <
&none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                &kp F6  &kp F7      &kp F8  &kp F9        &kp F10        &kp F11
&none  &none   &none   &none   &none   &none                 &none   &none       &none   &kp LS(SEMI)  &kp LS(APOS)   &kp F12
&none  &none   &none   &none   &none   &none   &none  &none  &none   &none       &none   &none         &kp PAGE_UP    &kp HOME
&none  &none   &none   &none   &none   &none                 &none   &kp DELETE  &none   &none         &kp PAGE_DOWN  &kp END
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "Rase";
            bindings = <
&kp K_CANCEL  &trans  &trans  &trans  &trans  &trans                       &kp KP_NUMLOCK   &kp KP_NUMBER_7  &kp KP_N8        &kp KP_N9        &kp KP_NUMBER_0  &trans
&trans        &trans  &trans  &trans  &trans  &trans                       &kp KP_DIVIDE    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS        &trans
&trans        &trans  &trans  &trans  &trans  &trans       &trans  &trans  &kp KP_MULTIPLY  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS      &kp LS(SLASH)
&trans        &trans  &trans  &trans  &trans  &kp K_CANCEL                 &trans           &trans           &trans           &kp KP_NUMBER_0  &kp KP_DOT       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        green_layer {
            display-name = "Gren";
            bindings = <
&kp K_CANCEL  &trans           &kp UP_ARROW  &trans           &trans            &trans                             &trans  &trans  &trans  &kp MINUS       &kp EQUAL       &kp DELETE
&trans        &kp LEFT_ARROW   &kp DOWN      &kp RIGHT_ARROW  &trans            &trans                             &trans  &trans  &trans  &kp LS(MINUS)   &kp LS(EQUAL)   &kp PAGE_UP
&trans        &trans           &trans        &trans           &trans            &trans       &mkp LCLK  &mkp RCLK  &trans  &trans  &trans  &trans           &kp UP_ARROW    &kp PAGE_DOWN
&trans        &trans           &trans        &kp LEFT_ALT     &kp LEFT_CONTROL  &kp LSHIFT                         &none   &none   &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings =
                <&mmv_up_down>,
                <&mmv_left_right>;
        };

        shortcut_layer {
            display-name = "Shot";
            bindings = <
&bt BT_CLR    &bt BT_SEL 3    &mmv MOVE_UP    &none            &rgbrepo            &studio_unlock                  &none  &none     &kp UP_ARROW  &kp LA(MINUS)   &none             &kp SCROLLLOCK
&bt BT_SEL 0  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &ext_power EP_OFF   &ext_power EP_ON                &none  &kp LEFT  &kp DOWN      &kp RIGHT       &kp LS(LC(SEMI))  &kp LC(RET)
&bt BT_SEL 1  &none           &none           &none            &out OUT_USB        &out OUT_BLE      &none  &none  &none  &none     &none         &none           &msc SCRL_UP      &none
&bt BT_SEL 2  &none           &none           &none            &none               &none                           &none  &none     &none         &msc SCRL_LEFT  &msc SCRL_DOWN    &msc SCRL_RIGHT
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
